DEV_MODE=false
ESTORE_APP_PORT=5000

# Derived by scripts/prepare-deployment.py from pingbusinessEnvironment.
# staging    -> https://biz-app.staging.pingbusiness.org
# production -> https://biz-app.pingbusiness.org
BIZ_APP_BASE_URL=https://biz-app.staging.pingbusiness.org
ESTORE_PUBLIC_BASE_URL=https://shop.example.com/api

PINGBIZ_MERCHANT_IDENTIFIER=
PINGBIZ_STORE_IDENTIFIER=
PINGBIZ_MERCHANT_API_KEY=

# Private Docker/platform address. Keycloak itself listens at / internally;
# the public edge exposes it at https://shop.example.com/auth.
ESTORE_KC_SERVER_URL=http://keycloak:8080
ESTORE_REALM=ESTORE
ESTORE_CLIENT_ID=estore-app
ESTORE_CLIENT_SECRET=

ESTORE_ALLOWED_ORIGINS=https://shop.example.com
ESTORE_TRUST_PROXY_HEADERS=true
ESTORE_CHECKOUT_FRAME_ANCESTORS='self'
ESTORE_CHECKOUT_LANG=

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
