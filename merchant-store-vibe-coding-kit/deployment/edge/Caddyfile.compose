{
  admin off
  email {$ACME_EMAIL:admin@example.com}
}

# Defines the (routes) snippet. Without this file import, `import routes` below
# fails config adaptation and the edge never starts.
import routes.caddy

# Docker health check; this listener is not published by Compose.
:8080 {
  respond /edge-health "ok" 200
}

{$STORE_ADDRESS:http://localhost} {
  import routes
}
